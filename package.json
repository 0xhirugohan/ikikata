{
	"name": "ikikata",
	"version": "0.4.0",
	"description": "A monorepo template built with Bun, Hono, Vite, and React",
	"author": "Steve Simkins",
	"license": "MIT",
	"homepage": "https://github.com/stevedylandev/bhvr",
	"packageManager": "bun@1.2.4",
	"workspaces": [
		"./server",
		"./client",
		"./shared"
	],
	"scripts": {
		"dev": "turbo dev",
		"dev:client": "turbo dev --filter=client",
		"dev:server": "turbo dev --filter=server",
		"dev:d1": "turbo dev:d1 --filter=server",
		"build": "turbo build",
		"build:client": "turbo build --filter=client",
		"build:server": "turbo build --filter=server",
		"build:d1": "turbo build:d1 --filter=server",
		"deploy": "turbo deploy --filter=server",
		"lint": "biome lint .",
		"type-check": "turbo type-check",
		"test": "turbo test",
		"postinstall": "turbo build --filter=shared --filter=server",
		"format": "biome format . --write",
		"db:setup": "turbo db:setup --filter=server",
		"db:migrate": "turbo db:migrate --filter=server",
		"db:migrate:local": "turbo db:migrate:local --filter=server",
		"db:status": "turbo db:status --filter=server",
		"db:status:local": "turbo db:status:local --filter=server",
		"db:shell": "cd server && npm run db:shell",
		"db:shell:local": "cd server && npm run db:shell:local"
	},
	"keywords": [
		"bun",
		"hono",
		"react",
		"vite",
		"monorepo",
		"turbo"
	],
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"bun-types": "latest",
		"turbo": "^2.5.5"
	},
	"peerDependencies": {
		"typescript": "^5.7.3"
	},
	"dependencies": {
		"hono": "^4.9.2"
	}
}
